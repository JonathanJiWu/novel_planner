# Production settings for app.py. Never commit real values.

# --- Accounts -----------------------------------------------------------
# Leave the Supabase values empty to use the built-in accounts (SQLite).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Needed for the Database admin page in Supabase mode.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
PUBLIC_APP_URL=http://127.0.0.1:8000
OAUTH_PROVIDERS=google,github,apple,facebook

# Built-in accounts: where accounts and projects are stored. Use a persistent
# disk in production. Relative paths are resolved from the project folder.
NOVEL_PLANNER_DB=/var/data/novel_planner.db
# Optional: a long random value used to sign sessions. If empty, the server
# generates one and keeps it in the database.
AUTH_SECRET=

# Comma-separated. These addresses can open "Database admin". With built-in
# accounts they can only be created on the server: python manage.py create-user EMAIL
ADMIN_EMAILS=

# Must be true for any deployment other people can reach. When false, requests
# without a session share one project (handy for local development only).
AUTH_REQUIRED=false

# Only needed if the browser app is served from a different origin than the API.
ALLOWED_ORIGINS=http://127.0.0.1:8000
